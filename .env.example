# ─── AI Content Bridge — License Server env ───────────────────────────────
# Copy to .env for local dev. On Railway, set these as service variables.
# Do NOT commit real values. PORT is injected by Railway — do not set it.

# Core
NODE_ENV=production
DATABASE_URL=            # Railway: reference ${{Postgres.DATABASE_URL}} (don't paste a literal)

# Auth / secrets
ADMIN_SECRET=            # x-admin-secret for the admin panel (acb-admin.html)
PORTAL_JWT_SECRET=       # signs customer-portal JWTs
GENERATE_SECRET=         # shared secret with the WP plugin (audit: move to per-install)

# Stripe (same Stripe account as before; webhook secret is NEW per endpoint)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=   # from the NEW webhook endpoint pointing at this server's domain
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# Generation APIs (consider ACB-specific keys, separate from LearnBridge)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=
BETA_FEEDBACK_EMAIL=
SUPPORT_EMAIL=

# URLs (point at ACB, not learn-bridge)
PORTAL_URL=              # the customer-portal URL
SERVER_URL=             # this server's own public URL (for building links)

# CORS — comma-separated browser origins for the ACB portals/site.
# The WP plugin is server-to-server (no Origin) and is unaffected.
CORS_ALLOWED_ORIGINS=https://aicontentbridge.com,https://www.aicontentbridge.com
